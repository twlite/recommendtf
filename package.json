{
  "name": "recommendtf",
  "version": "0.2.0",
  "description": "TensorFlow.js collaborative filtering for small Node.js applications",
  "main": "dist/index.js",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test tests/*.test.cjs .github/scripts/*.test.mjs",
    "test:release": "node --test .github/scripts/*.test.mjs",
    "example": "tsx examples/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "recommendation",
    "collaborative filtering",
    "tensorflow.js",
    "machine learning",
    "node.js",
    "typescript"
  ],
  "author": "Twilight <hello@twlite.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twlite/recommendtf.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.16.1",
  "peerDependencies": {
    "@tensorflow/tfjs": "^4.22.0"
  },
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
